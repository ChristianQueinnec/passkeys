{
	"name": "passkeys",
	"private": true,
	"version": "0.1.30",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"package:local": "scripts/package-local.sh",
		"package:linux": "scripts/package-local.sh linux-x64",
		"package:macos": "scripts/package-local.sh macos-arm64",
		"preview": "vite preview --port 3000",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest run tests/unit",
		"test:package": "scripts/test-packaged.sh",
		"reset-db": "scripts/init.sh -t",
		"test:e2e": "npm run reset-db && npx playwright test tests/e2e --workers=1",
		"tests": "make run.tests",
		"build:container": "docker compose build",
		"demo": "make run.demo"
	},
	"devDependencies": {
		"@playwright/mcp": "^0.0.75",
		"@playwright/test": "1.58.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-node": "^5.4.0",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"esbuild": "^0.27.2",
		"@yao-pkg/pkg": "^6.11.0",
		"@types/dompurify": "^3.0.5",
		"@types/node": "^25.0.1",
		"@types/proper-lockfile": "^4.1.4",
		"jsdom": "^29.0.0",
		"svelte": "^5.56.0",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"vite": "^7.2.6",
		"vite-plugin-devtools-json": "^1.0.0",
		"vite-plugin-pwa": "^1.2.0",
		"vitest": "^4.0.15"
	},
	"dependencies": {
		"dompurify": "^3.3.1",
		"pino": "^10.3.0",
		"pino-pretty": "^13.1.3",
		"proper-lockfile": "^4.1.2",
		"snarkdown": "^2.0.0"
	},
	"overrides": {
		"playwright": "1.58.0",
		"playwright-core": "1.58.0",
		"@playwright/test": "1.58.0"
	},
	"pkg": {
		"assets": ["build/**/*"]
	},
	"license": "GPL3"
}
