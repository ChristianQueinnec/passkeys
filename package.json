{
	"name": "passkeys",
	"private": true,
	"version": "0.1.5",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest run tests/unit",
		"reset-db": "echo '[{\"username\":\"admin\",\"password\":\"password\"},{\"username\":\"q\",\"password\":\"q\"},{\"username\":\"auth_test\",\"password\":\"q\"},{\"username\":\"history_test\",\"password\":\"q\"}]' > data/users.json && find data -mindepth 1 -not -name 'users.json' -exec rm -rf {} +",
		"test:e2e": "npm run reset-db && playwright test tests/e2e --workers=1",
		"tests": "npm run test:unit && npm run test:e2e",
		"build:container": "docker compose build"
	},
	"devDependencies": {
		"@playwright/test": "^1.57.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-node": "^5.4.0",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/node": "^25.0.1",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"vite": "^7.2.6",
		"vite-plugin-pwa": "^1.2.0",
		"vitest": "^4.0.15"
	}
}